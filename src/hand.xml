<mujoco model="tri_hand">
  <compiler angle="radian" meshdir="meshes" autolimits="true"/>
  <option gravity="0 -9.81 0" integrator="implicitfast" timestep="0.002"/>
<!-- 실물 세계와 시뮬레이션 세계의 단위계와 중력 방향 일치화-->


  <asset>
    <mesh name="palm_base" file="palm_base.stl" scale="0.001 0.001 0.001"/>
    <mesh name="thumb_mount" file="thumb_mount.stl" scale="0.001 0.001 0.001"/>
    <mesh name="actuator" file="actuator.stl" scale="0.001 0.001 0.001"/>
    <mesh name="hinge_frame" file="hinge_frame.stl" scale="0.001 0.001 0.001"/>
  </asset>

  <default>
    <joint type="hinge" axis="1 0 0" range="-1.5708 1.5708" limited="true" damping="0.15" armature="0.01"/>
<!-- range = -90 ~ +90 -->
    <!-- 시각용: 원본 STL. 충돌 없음, group 1 -->
    <default class="visual">
      <geom type="mesh" density="0" contype="0" conaffinity="0" group="1"/>
    </default>

    <!-- 충돌용: 단순 프리미티브. group 3 (뷰어에서 '3' 키로 토글) -->
    <default class="collision">
      <geom density="0" contype="1" conaffinity="1" group="3"
            friction="1.0 0.005 0.0001" rgba="1 0.5 0 0.3"/>
    </default>

    <!-- XL430-W250-T 대응: kp는 기존값 유지, kv 추가로 오버슈트 억제 -->
    <position kp="12" kv="0.5" forcerange="-1.4 1.4" ctrlrange="-1.5708 1.5708"/>
  </default>

  <worldbody>
    <light pos="0 1 0" dir="0 -1 0"/>

    <!-- ===== Palm (고정 베이스) ===== -->
    <geom name="palm" class="visual" mesh="palm_base" rgba="0.22 0.47 0.76 1"/>
    <!-- 팜 충돌 근사 (단위 m) -->
    <geom name="palm_disc"      class="collision" type="cylinder" size="0.090"
          fromto="0.030 -0.1395 0.058  0.030 -0.1280 0.058"/>
    <geom name="palm_hub"       class="collision" type="box"
          pos="0.0298 -0.0950 0.0450" size="0.0265 0.0310 0.0220"/>
    <geom name="palm_bracket_BC" class="collision" type="box"
          pos="0.0298 -0.0655 0.0220" size="0.0550 0.0030 0.0260"/>

    <!-- ===== Finger A (Swivel + 2-Link Thumb) ===== -->
    <!-- 7번째 액추에이터: 엄지 요/대립 관절 (회전축: Y축, 피벗: 모터 혼 중심) -->
    <body name="A_base" pos="0.02975 -0.07078 0.06011">
      <joint name="A_j0" axis="0 1 0" pos="0 0 0" range="-1.0472 1.0472"/> <!-- -60 ~ 60-->
      <inertial pos="0 0.025 0.025" mass="0.05" diaginertia="1.5e-05 1.5e-05 1.5e-05"/>
      <geom name="thumb_mount" class="visual" mesh="thumb_mount"
            pos="-0.02975 0.07078 -0.06011" rgba="0.95 0.75 0.15 1"/>
      <geom name="thumb_bracket_col" class="collision" type="box"
            pos="0 0.0057 0.0469" size="0.0185 0.0030 0.0170"/>

      <!-- Hinge Frame 1 (A_base에 고정 결합) -->
      <geom name="A_frame1" class="visual" mesh="hinge_frame"
            pos="-0.00075 0.04818 0.04989" euler="0 0 3.14159" rgba="0.95 0.75 0.15 1"/>

      <body name="A_link1" pos="-0.00075 0.04818 0.04989">
        <joint name="A_j1" pos="0 -0.011475 0"/>
        <inertial pos="0 0.015 0" mass="0.07" diaginertia="2.773e-05 1.486e-05 3.344e-05"/>
        <geom name="A_actuator1" class="visual" mesh="actuator" euler="0 0 3.14159" rgba="0.82 0.29 0.36 1"/>
        <geom class="collision" type="box" pos="0.00134 0.00052 -0.00003" size="0.01895 0.02325 0.01425"/>
        <!-- Hinge Frame 2 (Actuator 1 상단에 고정 결합) -->
        <geom name="A_frame2" class="visual" mesh="hinge_frame" pos="0 0.0633 0" euler="0 0 3.14159" rgba="0.82 0.29 0.36 1"/>

        <body name="A_link2" pos="0 0.0633 0">
          <joint name="A_j2" pos="0 -0.011475 0"/>
          <inertial pos="0 0.015 0" mass="0.07" diaginertia="2.773e-05 1.486e-05 3.344e-05"/>
          <geom name="A_actuator2" class="visual" mesh="actuator" euler="0 0 3.14159" rgba="0.12 0.62 0.47 1"/>
          <geom class="collision" type="box" pos="0.00134 0.00052 -0.00003" size="0.01895 0.02325 0.01425"/>
        </body>
      </body>
    </body>

    <!-- ===== Finger B ===== -->
    <!-- Hinge Frame 1 (Palm 베이스에 고정) -->
    <geom name="B_frame1" class="visual" mesh="hinge_frame"
          pos="-0.0050 -0.0230 0.0100" euler="0 0 3.14159" rgba="0.22 0.47 0.76 1"/>

    <body name="B_link1" pos="-0.0050 -0.0230 0.0100">
      <joint name="B_j1" pos="0 -0.011475 0"/>
      <inertial pos="0 0.015 0" mass="0.07" diaginertia="2.773e-05 1.486e-05 3.344e-05"/>
      <geom name="B_actuator1" class="visual" mesh="actuator" euler="0 0 3.14159" rgba="0.82 0.29 0.36 1"/>
      <geom class="collision" type="box" pos="0.00134 0.00052 -0.00003" size="0.01895 0.02325 0.01425"/>
      <!-- Hinge Frame 2 (Actuator 1 상단에 고정 결합) -->
      <geom name="B_frame2" class="visual" mesh="hinge_frame" pos="0 0.0633 0" euler="0 0 3.14159" rgba="0.82 0.29 0.36 1"/>

      <body name="B_link2" pos="0 0.0633 0">
        <joint name="B_j2" pos="0 -0.011475 0"/>
        <inertial pos="0 0.015 0" mass="0.07" diaginertia="2.773e-05 1.486e-05 3.344e-05"/>
        <geom name="B_actuator2" class="visual" mesh="actuator" euler="0 0 3.14159" rgba="0.12 0.62 0.47 1"/>
        <geom class="collision" type="box" pos="0.00134 0.00052 -0.00003" size="0.01895 0.02325 0.01425"/>
      </body>
    </body>

    <!-- ===== Finger C ===== -->
    <!-- Hinge Frame 1 (Palm 베이스에 고정) -->
    <geom name="C_frame1" class="visual" mesh="hinge_frame"
          pos="0.0650 -0.0230 0.0100" euler="0 0 3.14159" rgba="0.22 0.47 0.76 1"/>

    <body name="C_link1" pos="0.0650 -0.0230 0.0100">
      <joint name="C_j1" pos="0 -0.011475 0"/>
      <inertial pos="0 0.015 0" mass="0.07" diaginertia="2.773e-05 1.486e-05 3.344e-05"/>
      <geom name="C_actuator1" class="visual" mesh="actuator" euler="0 0 3.14159" rgba="0.82 0.29 0.36 1"/>
      <geom class="collision" type="box" pos="0.00134 0.00052 -0.00003" size="0.01895 0.02325 0.01425"/>
      <!-- Hinge Frame 2 (Actuator 1 상단에 고정 결합) -->
      <geom name="C_frame2" class="visual" mesh="hinge_frame" pos="0 0.0633 0" euler="0 0 3.14159" rgba="0.82 0.29 0.36 1"/>

      <body name="C_link2" pos="0 0.0633 0">
        <joint name="C_j2" pos="0 -0.011475 0"/>
        <inertial pos="0 0.015 0" mass="0.07" diaginertia="2.773e-05 1.486e-05 3.344e-05"/>
        <geom name="C_actuator2" class="visual" mesh="actuator" euler="0 0 3.14159" rgba="0.12 0.62 0.47 1"/>
        <geom class="collision" type="box" pos="0.00134 0.00052 -0.00003" size="0.01895 0.02325 0.01425"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="A_j0_act" joint="A_j0" ctrlrange="-1.0472 1.0472"/>
    <position name="A_j1_act" joint="A_j1"/>
    <position name="A_j2_act" joint="A_j2"/>
    <position name="B_j1_act" joint="B_j1"/>
    <position name="B_j2_act" joint="B_j2"/>
    <position name="C_j1_act" joint="C_j1"/>
    <position name="C_j2_act" joint="C_j2"/>
  </actuator>
</mujoco>
